generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model ShoeModel {
  id String @id
  name String
  slug String @unique
  category String
  description String
  weightGrams Int
  dropMm Int
  imagePath String
  officialUrl String
  compatibility Json
  technicalProfile Json?
  active Boolean @default(true)
  createdAt DateTime @default(now())
}
model WizardSession {
  id String @id @default(cuid())
  name String?
  goal String?
  weeklyKm Int?
  workoutType String?
  distanceKm Float?
  surface String?
  ownedShoes String[]
  recommendation String?
  score Int?
  biomechanics Json?
  algorithmVersion String @default("wizard-recommender-3.1.0")
  completedAt DateTime?
  createdAt DateTime @default(now())
}
