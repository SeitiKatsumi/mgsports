generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum ShoeStatus {
  NEW
  ACTIVE
  ATTENTION
  RETIRED
}

enum ShoeCondition {
  LIKE_NEW
  NORMAL
  WORN
  VERY_WORN
}

enum WorkoutSource {
  MANUAL
  STRAVA
  GARMIN
}

model User {
  id              String               @id @default(cuid())
  email           String               @unique
  passwordHash    String
  name            String
  role            UserRole             @default(USER)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  runnerProfile   RunnerProfile?
  personalRecords PersonalRecord[]
  connections     TrainingConnection[]
  workouts        Workout[]
  workoutPlans    WorkoutPlan[]
  shoes           UserShoe[]
  recommendations Recommendation[]
  feedback        ShoeFeedback[]
  purchases       Purchase[]
  notifications   Notification[]
  preferences     UserPreference?
  consents        Consent[]
  analytics       AnalyticsEvent[]
}

model RunnerProfile {
  id                  String    @id @default(cuid())
  userId              String    @unique
  city                String?   @db.VarChar(120)
  state               String?   @db.VarChar(2)
  country             String    @default("Brasil")
  birthDate           DateTime?
  heightCm            Int?
  weightKg            Float?
  experience          String?
  weeklyVolumeKm      Float?
  goals               String[]
  footStrike          String?
  onboardingCompleted Boolean   @default(false)
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PersonalRecord {
  id              String        @id @default(cuid())
  userId          String
  distanceMeters  Int
  durationSeconds Int
  source          WorkoutSource @default(MANUAL)
  achievedAt      DateTime?
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TrainingConnection {
  id                    String    @id @default(cuid())
  userId                String
  provider              String
  externalUserId        String?
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  expiresAt             DateTime?
  status                String    @default("disconnected")
  lastSyncAt            DateTime?
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

model Workout {
  id                 String           @id @default(cuid())
  userId             String
  title              String
  distanceKm         Float
  durationMinutes    Int?
  targetPace         String?
  actualPace         String?
  heartRateAvg       Int?
  heartRateMax       Int?
  elevationGain      Int?
  surface            String
  terrain            String?
  intensity          String
  workoutType        String
  rpe                Int?
  source             WorkoutSource    @default(MANUAL)
  externalActivityId String?
  date               DateTime
  shoeUsedId         String?
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  shoeUsed           UserShoe?        @relation(fields: [shoeUsedId], references: [id])
  recommendations    Recommendation[]
  usages             ShoeUsage[]

  @@unique([source, externalActivityId])
  @@index([userId, date])
}

model WorkoutPlan {
  id          String   @id @default(cuid())
  userId      String
  title       String
  workoutType String
  distanceKm  Float
  targetPace  String?
  surface     String   @default("asfalto")
  scheduledAt DateTime
  status      String   @default("planned")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ShoeModel {
  id                    String                 @id
  brand                 String                 @default("Olympikus")
  family                String                 @default("Corre")
  model                 String
  slug                  String                 @unique
  version               String?
  weightGrams           Int
  referenceSize         Int                    @default(40)
  dropMm                Int
  category              String
  primaryUse            String
  secondaryUses         String[]
  midsole               String
  plate                 String?
  plateMaterial         String?
  upper                 String
  insole                String
  outsole               String
  rocker                String?
  surfaceCompatibility  String[]
  performanceProfile    Json
  officialDescription   String
  worldAthleticsStatus  String?
  accentColor           String                 @default("#ff4d16")
  active                Boolean                @default(true)
  recommendedMileageMin Int?
  recommendedMileageMax Int?
  createdAt             DateTime               @default(now())
  skus                  ShoeSku[]
  compatibility         WorkoutCompatibility[]
  userShoes             UserShoe[]
  recommendations       Recommendation[]
}

model ShoeSku {
  id          String           @id @default(cuid())
  shoeModelId String
  color       String
  size        String
  sku         String           @unique
  imageUrl    String?
  active      Boolean          @default(true)
  model       ShoeModel        @relation(fields: [shoeModelId], references: [id], onDelete: Cascade)
  inventories StoreInventory[]
  offers      OnlineOffer[]
}

model WorkoutCompatibility {
  id          String    @id @default(cuid())
  shoeModelId String
  workoutType String
  score       Int
  model       ShoeModel @relation(fields: [shoeModelId], references: [id], onDelete: Cascade)

  @@unique([shoeModelId, workoutType])
}

model UserShoe {
  id                      String           @id @default(cuid())
  userId                  String
  shoeModelId             String
  colorway                String
  size                    String
  purchaseDate            DateTime?
  purchasePrice           Decimal?         @db.Decimal(10, 2)
  retailerId              String?
  initialMileage          Float            @default(0)
  currentMileage          Float            @default(0)
  manualMileageAdjustment Float            @default(0)
  status                  ShoeStatus       @default(ACTIVE)
  lastUsedAt              DateTime?
  usageCount              Int              @default(0)
  favorite                Boolean          @default(false)
  condition               ShoeCondition    @default(NORMAL)
  notes                   String?
  createdAt               DateTime         @default(now())
  retiredAt               DateTime?
  user                    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  model                   ShoeModel        @relation(fields: [shoeModelId], references: [id])
  workouts                Workout[]
  usages                  ShoeUsage[]
  recommendations         Recommendation[] @relation("RecommendedUserShoe")

  @@index([userId, status])
}

model ShoeUsage {
  id         String   @id @default(cuid())
  userShoeId String
  workoutId  String
  distanceKm Float
  createdAt  DateTime @default(now())
  shoe       UserShoe @relation(fields: [userShoeId], references: [id], onDelete: Cascade)
  workout    Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  @@unique([userShoeId, workoutId])
}

model Recommendation {
  id                     String                 @id @default(cuid())
  userId                 String
  workoutId              String?
  recommendedUserShoeId  String?
  recommendedShoeModelId String
  score                  Int
  confidence             String
  algorithmVersion       String
  createdAt              DateTime               @default(now())
  accepted               Boolean?
  actualShoeUsed         String?
  factors                RecommendationFactor[]
  user                   User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout                Workout?               @relation(fields: [workoutId], references: [id])
  userShoe               UserShoe?              @relation("RecommendedUserShoe", fields: [recommendedUserShoeId], references: [id])
  shoeModel              ShoeModel              @relation(fields: [recommendedShoeModelId], references: [id])
}

model RecommendationFactor {
  id               String         @id @default(cuid())
  recommendationId String
  type             String
  impact           Float
  messageKey       String
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
}

model ShoeFeedback {
  id         String   @id @default(cuid())
  userId     String
  userShoeId String?
  workoutId  String?
  mood       Int
  comfort    Int?
  speed      Int?
  stability  Int?
  fit        Int?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Purchase {
  id               String   @id @default(cuid())
  userId           String
  shoeModelName    String
  version          String?
  color            String?
  size             String?
  purchasedAt      DateTime
  price            Decimal? @db.Decimal(10, 2)
  retailerName     String?
  totalMileage     Float    @default(0)
  satisfaction     Int?
  retirementReason String?
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Store {
  id           String           @id @default(cuid())
  name         String
  type         String
  address      String
  city         String
  state        String
  zipCode      String
  latitude     Float?
  longitude    Float?
  phone        String?
  website      String?
  openingHours Json?
  active       Boolean          @default(false)
  inventories  StoreInventory[]
}

model StoreInventory {
  id               String   @id @default(cuid())
  storeId          String
  skuId            String
  size             String
  color            String
  stock            Int
  price            Decimal  @db.Decimal(10, 2)
  promotionalPrice Decimal? @db.Decimal(10, 2)
  updatedAt        DateTime @updatedAt
  store            Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sku              ShoeSku  @relation(fields: [skuId], references: [id], onDelete: Cascade)
}

model Retailer {
  id     String        @id @default(cuid())
  name   String
  active Boolean       @default(false)
  offers OnlineOffer[]
}

model OnlineOffer {
  id                String   @id @default(cuid())
  retailerId        String
  skuId             String
  size              String
  price             Decimal  @db.Decimal(10, 2)
  shippingPrice     Decimal  @db.Decimal(10, 2)
  estimatedDelivery String?
  productUrl        String
  inStock           Boolean  @default(false)
  updatedAt         DateTime @updatedAt
  retailer          Retailer @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  sku               ShoeSku  @relation(fields: [skuId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserPreference {
  id            String   @id @default(cuid())
  userId        String   @unique
  reducedMotion Boolean  @default(false)
  notifications Boolean  @default(true)
  marketing     Boolean  @default(false)
  budgetMax     Decimal? @db.Decimal(10, 2)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Consent {
  id        String    @id @default(cuid())
  userId    String
  type      String
  granted   Boolean
  version   String
  grantedAt DateTime  @default(now())
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model SyncLog {
  id        String   @id @default(cuid())
  provider  String
  userId    String
  status    String
  imported  Int      @default(0)
  error     String?
  createdAt DateTime @default(now())
}

model AlgorithmConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  version   String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  entity    String
  entityId  String
  action    String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  userId     String?
  name       String
  properties Json?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([name, createdAt])
}
